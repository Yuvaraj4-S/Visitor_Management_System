 "message": "<div style=\"font-family:Arial,sans-serif;font-size:13px;color:#1f2933;background-color:#ffffff;padding:14px;border-radius:6px;max-width:420px;\">\n<p style=\"margin:0 0 8px;color:#102a43;font-size:14px;line-height:1.5;\">Your hospitality request <b style=\"color:#102a43;\"><a href=\"{{ frappe.utils.get_url_to_form(doc.doctype, doc.name) }}\" style=\"color:#2563eb;text-decoration:none;\">{{ (doc.name) | e }}</a></b> was <span style=\"font-weight:bold;color:{% if doc.workflow_state == 'Approved' %}#1a7f37{% else %}#dc3545{% endif %};\">{{ (doc.workflow_state | lower) | e }}</span>.</p>\n<p style=\"margin:0 0 12px;color:#3e4c59;font-size:13px;line-height:1.7;word-break:break-word;\">\n<b style=\"color:#5b6b7b;\">Visitor:</b> <span style=\"color:#1f2933;\">{{ (doc.visitor_name_display or '-') | e }}</span> &middot; <b style=\"color:#5b6b7b;\">Pass:</b> <span style=\"color:#1f2933;\">{{ (doc.visitor_pass) | e }}</span><br>\n<b style=\"color:#5b6b7b;\">Visit window:</b> <span style=\"color:#1f2933;\">{{ (doc.visit_start_time or '-') | e }}&ndash;{{ (doc.visit_end_time or '-') | e }}</span>\n</p>\n{% if doc.workflow_state == 'Rejected' %}<p style=\"margin:0 0 0;color:#1f2933;font-size:12px;line-height:1.5;\">Nothing will be arranged for this visit. Ask the Hospitality Manager why, adjust the request and use Actions &rarr; Reapply.</p>{% endif %}\n<p style=\"margin:12px 0 0;\"><a href=\"{ frappe.utils.get_url_to_form(doc.doctype, doc.name) }\" style=\"display:inline-block;background:#2563eb;color:#ffffff;padding:7px 14px;text-decoration:none;border-radius:4px;font-size:13px;font-weight:600;\">Open Request &rarr;</a></p>\n</div>",
