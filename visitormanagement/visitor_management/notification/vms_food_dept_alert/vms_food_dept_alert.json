 "message": "<div style=\"font-family: Arial, sans-serif; font-size: 13px; color: #1f2933; background-color: #ffffff; padding:14px; border-radius:6px;max-width:520px;\">\n<h3 style=\"color: #102a43;\">Meal Request for Visitor</h3>\n<p>Please arrange meal service for the following visitor.</p>\n\n<table style=\"border-collapse: collapse; width: 100%; margin: 12px 0;table-layout:fixed;\">\n<tr style=\"\"><td style=\"padding:5px 2px; border-bottom:1px solid #edf0f2;word-break:break-word;width:40%;\"><b style=\"color:#5b6b7b;\">Visitor</b></td><td style=\"padding:5px 2px; border-bottom:1px solid #edf0f2;word-break:break-word;\">{{ doc.visitor_full_name }}</td></tr>\n<tr><td style=\"padding:5px 2px; border-bottom:1px solid #edf0f2;word-break:break-word;width:40%;\"><b style=\"color:#5b6b7b;\">Company</b></td><td style=\"padding:5px 2px; border-bottom:1px solid #edf0f2;word-break:break-word;\">{{ doc.company__organisation or 'N/A' }}</td></tr>\n<tr style=\"\"><td style=\"padding:5px 2px; border-bottom:1px solid #edf0f2;word-break:break-word;width:40%;\"><b style=\"color:#5b6b7b;\">Visit Date</b></td><td style=\"padding:5px 2px; border-bottom:1px solid #edf0f2;word-break:break-word;\">{{ doc.visit_date }}</td></tr>\n<tr><td style=\"padding:5px 2px; border-bottom:1px solid #edf0f2;word-break:break-word;width:40%;\"><b style=\"color:#5b6b7b;\">Meal Type</b></td><td style=\"padding:5px 2px; border-bottom:1px solid #edf0f2;word-break:break-word;\"><b style=\"color: #1f2933;\">{{ doc.meal_type }}</b></td></tr>\n<tr style=\"\"><td style=\"padding:5px 2px; border-bottom:1px solid #edf0f2;word-break:break-word;width:40%;\"><b style=\"color:#5b6b7b;\">Number of People</b></td><td style=\"padding:5px 2px; border-bottom:1px solid #edf0f2;word-break:break-word;\">{{ doc.number_of_people or 1 }}</td></tr>\n<tr><td style=\"padding:5px 2px; border-bottom:1px solid #edf0f2;word-break:break-word;width:40%;\"><b style=\"color:#5b6b7b;\">Dietary Preference</b></td><td style=\"padding:5px 2px; border-bottom:1px solid #edf0f2;word-break:break-word;\">{{ doc.special_diet or 'None' }}</td></tr>\n<tr style=\"\"><td style=\"padding:5px 2px; border-bottom:1px solid #edf0f2;word-break:break-word;width:40%;\"><b style=\"color:#5b6b7b;\">Service Time</b></td><td style=\"padding:5px 2px; border-bottom:1px solid #edf0f2;word-break:break-word;\">{{ doc.service_time or doc.expected_checkin }}</td></tr>\n\n<tr style=\"\"><td style=\"padding:5px 2px; border-bottom:1px solid #edf0f2;word-break:break-word;width:40%;\"><b style=\"color:#5b6b7b;\">Host</b></td><td style=\"padding:5px 2px; border-bottom:1px solid #edf0f2;word-break:break-word;\">{{ doc.host_name or doc.person_to_visit }}</td></tr>\n</table>\n\n{% if doc.hospitality_notes %}\n<p><b style=\"color: #1f2933;\">Notes:</b></p>\n<p style=\"background: #fffbe6; padding:5px 2px; border-left: 3px solid #f0c000;\">{{ doc.hospitality_notes }}</p>\n{% endif %}\n\n<p style=\"margin-top: 16px;\"><a style=\"color: #1e40af;\" href=\"{{ frappe.utils.get_url() }}/app/visitor-pass/{{ doc.name }}\">View Pass</a></p>\n</div>",
