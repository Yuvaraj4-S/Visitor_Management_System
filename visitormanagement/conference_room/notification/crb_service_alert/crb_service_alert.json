 "message": "<div style=\"font-family:Arial,sans-serif;font-size:13px;color:#1f2933;background-color:#ffffff;padding:14px;border-radius:6px;max-width:520px;\">\n<h3 style=\"color:#102a43;margin:0 0 10px;font-size:16px;\">Service Preparation Required</h3>\n<p style=\"color:#1f2933;margin:0 0 12px;\">A conference room booking has been confirmed for an <b style=\"color:#1f2933;\">{{ doc.meeting_type }}</b> meeting. Please arrange the following services before it starts.</p>\n\n<table role=\"presentation\" width=\"100%\" style=\"border-collapse:collapse;width:100%;table-layout:fixed;margin:12px 0;\">\n<tr style=\"\"><td style=\"padding:5px 2px;border-bottom:1px solid #edf0f2;color:#5b6b7b;word-break:break-word;width:40%;font-weight:bold;\">Booking ID</td><td style=\"padding:5px 2px;border-bottom:1px solid #edf0f2;color:#1f2933;word-break:break-word;\">{{ doc.name }}</td></tr>\n<tr><td style=\"padding:5px 2px;border-bottom:1px solid #edf0f2;color:#5b6b7b;word-break:break-word;width:40%;font-weight:bold;\">Meeting</td><td style=\"padding:5px 2px;border-bottom:1px solid #edf0f2;color:#1f2933;word-break:break-word;\">{{ doc.meeting_title }}</td></tr>\n<tr style=\"\"><td style=\"padding:5px 2px;border-bottom:1px solid #edf0f2;color:#5b6b7b;word-break:break-word;width:40%;font-weight:bold;\">Room</td><td style=\"padding:5px 2px;border-bottom:1px solid #edf0f2;color:#1f2933;word-break:break-word;\">{{ doc.conference_room }}</td></tr>\n<tr><td style=\"padding:5px 2px;border-bottom:1px solid #edf0f2;color:#5b6b7b;word-break:break-word;width:40%;font-weight:bold;\">Date</td><td style=\"padding:5px 2px;border-bottom:1px solid #edf0f2;color:#1f2933;word-break:break-word;\">{{ doc.booking_date }}</td></tr>\n<tr style=\"\"><td style=\"padding:5px 2px;border-bottom:1px solid #edf0f2;color:#5b6b7b;word-break:break-word;width:40%;font-weight:bold;\">Time</td><td style=\"padding:5px 2px;border-bottom:1px solid #edf0f2;color:#1f2933;word-break:break-word;\">{{ doc.start_time }} &ndash; {{ doc.end_time }}</td></tr>\n<tr><td style=\"padding:5px 2px;border-bottom:1px solid #edf0f2;color:#5b6b7b;word-break:break-word;width:40%;font-weight:bold;\">Expected Attendees</td><td style=\"padding:5px 2px;border-bottom:1px solid #edf0f2;color:#1f2933;word-break:break-word;\">{{ doc.expected_attendees }}</td></tr>\n</table>\n\n{% set services = [] %}\n{% if doc.room_cleaning_required %}{% set _ = services.append('Room Cleaning') %}{% endif %}\n{% if doc.coffee_tea_required %}{% set _ = services.append('Coffee / Tea') %}{% endif %}\n{% if doc.water_required %}{% set _ = services.append('Water / Beverages') %}{% endif %}\n{% if doc.snacks_required %}{% set _ = services.append('Snacks') %}{% endif %}\n<p style=\"color:#1f2933;margin:12px 0 6px;\"><b style=\"color:#1f2933;\">Services Required:</b></p>\n{% if services %}\n<ul style=\"color:#1f2933;margin:0 0 12px;padding-left:20px;\">\n{% for service in services %}<li style=\"color:#1f2933;\">{{ service }}</li>\n{% endfor %}</ul>\n{% else %}\n<p style=\"color:#1f2933;margin:0 0 12px;\">No additional services were requested for this booking.</p>\n{% endif %}\n\n{% if doc.special_instructions %}\n<p style=\"color:#1f2933;margin:12px 0 6px;\"><b style=\"color:#1f2933;\">Special Instructions:</b></p>\n<p style=\"background:#fffbe6;color:#1f2933;padding:5px 2px;border-left:3px solid #f0c000;margin:0 0 12px;word-break:break-word;\">{{ doc.special_instructions }}</p>\n{% endif %}\n\n<p style=\"margin-top:16px;\"><a style=\"color:#1e40af;\" href=\"{{ frappe.utils.get_url() }}/app/conference-room-booking/{{ doc.name }}\">View Booking</a></p>\n</div>",
